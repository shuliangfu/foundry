{
  "version": "1.9.0",
  "name": "@dreamer/foundry",
  "description": "Foundry deployment and verification utilities for Deno, Bun, and Node.js 22+",
  "license": "Apache-2.0",
  "exports": {
    ".": "./src/mod.ts",
    "./cli": "./src/cli.ts",
    "./deploy": "./src/deploy.ts",
    "./verify": "./src/verify.ts",
    "./setup": "./src/setup.ts",
    "./utils": "./src/utils/mod.ts",
    "./utils/env": "./src/utils/env.ts",
    "./utils/web3": "./src/utils/web3.ts",
    "./utils/logger": "./src/utils/logger.ts",
    "./utils/time": "./src/utils/time.ts"
  },
  "publish": {
    "exclude": [
      "tests/",
      "example/",
      ".cursor/",
      "*.test.ts",
      "*.test.js",
      "test-node.mjs"
    ]
  },
  "imports": {
    "@dreamer/i18n": "jsr:@dreamer/i18n@^1.1.2",
    "@dreamer/web3": "jsr:@dreamer/web3@^1.2.0",
    "@dreamer/logger": "jsr:@dreamer/logger@^1.1.0",
    "@dreamer/runtime-adapter": "jsr:@dreamer/runtime-adapter@^1.2.2",
    "@dreamer/test": "jsr:@dreamer/test@^1.2.3",
    "@dreamer/console": "jsr:@dreamer/console@^1.1.0"
  },
  "test": {
    "exclude": [
      "tests/data/**",
      "example/**"
    ]
  },
  "fmt": {
    "indentWidth": 2,
    "lineWidth": 100,
    "useTabs": false
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ],
      "exclude": [
        "no-explicit-any"
      ]
    }
  },
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "lib": ["deno.ns", "deno.window", "esnext"]
  },
  "allowScripts": {
    "allow": [],
    "deny": [
      "npm:esbuild@0.27.2",
      "npm:puppeteer@24.36.0"
    ]
  }
}
