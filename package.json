{
  "name": "@dreamer/foundry",
  "version": "1.9.0",
  "description": "Foundry deployment and verification utilities for Deno, Bun, and Node.js 22+.",
  "type": "module",
  "license": "Apache-2.0",
  "exports": {
    ".": "./src/mod.ts",
    "./cli": "./src/cli.ts",
    "./deploy": "./src/deploy.ts",
    "./verify": "./src/verify.ts",
    "./setup": "./src/setup.ts",
    "./utils": "./src/utils/mod.ts",
    "./utils/env": "./src/utils/env.ts",
    "./utils/web3": "./src/utils/web3.ts",
    "./utils/logger": "./src/utils/logger.ts",
    "./utils/time": "./src/utils/time.ts"
  },
  "scripts": {
    "test": "bun test tests/",
    "test:node": "CI=true tsx --tsconfig tsconfig.json --test --test-force-exit tests/*.test.ts",
    "check": "deno check src/mod.ts",
    "lint": "deno lint src/ tests/",
    "fmt": "deno fmt src/ tests/"
  },
  "dependencies": {
    "@dreamer/console": "npm:@jsr/dreamer__console@^1.1.0",
    "@dreamer/i18n": "npm:@jsr/dreamer__i18n@^1.1.2",
    "@dreamer/logger": "npm:@jsr/dreamer__logger@^1.1.0",
    "@dreamer/runtime-adapter": "npm:@jsr/dreamer__runtime-adapter@^1.2.2",
    "@dreamer/web3": "npm:@jsr/dreamer__web3@^1.2.0"
  },
  "devDependencies": {
    "@dreamer/test": "npm:@jsr/dreamer__test@^1.2.3",
    "tsx": "^4.19.2"
  },
  "engines": {
    "node": ">=22",
    "bun": ">=1.3"
  },
  "keywords": ["foundry", "web3", "deploy", "verify", "solidity", "dreamer"]
}
